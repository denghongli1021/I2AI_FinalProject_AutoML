# Copy to .env (do NOT commit .env) for local dev.
# On Render, set these in the dashboard's "Environment" tab.

# ---- JWT ----
# Use a long random string in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-long-random-string

# ---- Database ----
# Leave empty for local SQLite fallback (api/auth.db).
# Supabase: copy "Connection string" -> "URI" from Supabase project settings.
# Format: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=

# ---- OAuth: Google ----
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID, type "Web application".
# 3. Add Authorized redirect URI:
#      Local:  http://localhost:8000/api/auth/oauth/google/callback
#      Render: https://YOUR-APP.onrender.com/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- OAuth: GitHub ----
# 1. https://github.com/settings/developers -> OAuth Apps -> New
# 2. Authorization callback URL:
#      Local:  http://localhost:8000/api/auth/oauth/github/callback
#      Render: https://YOUR-APP.onrender.com/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Redirect URLs (used by OAuth flow) ----
# OAUTH_REDIRECT_BASE: the URL where this backend is reachable.
# FRONTEND_URL:        the URL of the frontend SPA; OAuth callback redirects here with ?token=...
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5500
